# Template for .env.tenancy — copy, fill in, and keep the real file out of git.
#
#   ./packages/database/bootstrap/generate-tenancy-credentials.sh
#
# generates .env.tenancy with fresh random passwords. .env.tenancy is gitignored
# (.env.* in .gitignore); this .example file is the committed record of which
# variables exist and what each role is for.
#
# Three roles, three different privilege levels. The split is the point: the
# serving API can never create a schema or a role, and provisioning can never
# read tenant data.

MULTI_TENANCY_ENABLED=true

# ovl_api — the serving API's connection pool.
# NOINHERIT and owns nothing. It is a member of every tenant role but holds
# none of their privileges until a transaction runs SET LOCAL ROLE. Without
# that, it can read the tenant registry and nothing else.
OVL_API_DB_USER=ovl_api
OVL_API_DB_PASSWORD=
DATABASE_URL=postgresql://ovl_api:CHANGEME@localhost:5432/ovl_office

# ovl_admin — tenant provisioning only.
# CREATEROLE + CREATE on the database, NOT a superuser. Used by the tenant CLI.
# Leave ADMIN_DATABASE_URL UNSET in the serving API process: provisioning is
# then disabled there, so a bug on a request path cannot create privileges for
# itself.
OVL_ADMIN_DB_USER=ovl_admin
OVL_ADMIN_DB_PASSWORD=
ADMIN_DATABASE_URL=postgresql://ovl_admin:CHANGEME@localhost:5432/ovl_office

# Superuser — running platform-bootstrap.sql, once, and nothing else.
SUPERUSER_DATABASE_URL=postgresql://ovl:ovl@localhost:5432/ovl_office

# Connections per Node process. Budget as
#   API instances x Node processes x PG_POOL_MAX <= max_connections
PG_POOL_MAX=15
